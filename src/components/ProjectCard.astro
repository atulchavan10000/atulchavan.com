---
import type { Project } from '../data/site';
import ProjectVisual from './ProjectVisual.astro';
interface Props { project: Project; linked?: boolean; }
const { project, linked = true } = Astro.props;
---
<article class="project-card" id={linked ? undefined : project.slug}>
  <ProjectVisual kind={project.visual} />
  <div class="project-body">
    <p class="project-category">{project.category}<span>{project.number}</span></p>
    <h3>{linked ? <a href={`/projects#${project.slug}`}>{project.title}<span aria-hidden="true">↗</span></a> : project.title}</h3>
    <p class="project-description">{project.description}</p>
    <ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul>
  </div>
</article>
